FROM docker.io/pytorch/pytorch:2.1.2-cuda12.1-cudnn8-runtime

ENV DEBIAN_FRONTEND=noninteractive \
    HF_HOME=/models/genau/huggingface \
    TORCH_HOME=/models/genau/torch-hub \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/opt/GenAU/GenAU

RUN apt-get update && apt-get install -y --no-install-recommends \
        ffmpeg git libasound2-plugins libsndfile1 libportaudio2 pulseaudio-utils \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir sounddevice==0.5.5

RUN git clone https://github.com/snap-research/GenAU.git /opt/GenAU \
    && git -C /opt/GenAU checkout c9bd661

COPY genau/patches/0001-modern-xformers-compat.patch /tmp/0001-modern-xformers-compat.patch
RUN git -C /opt/GenAU apply --check /tmp/0001-modern-xformers-compat.patch \
    && git -C /opt/GenAU apply /tmp/0001-modern-xformers-compat.patch \
    && rm /tmp/0001-modern-xformers-compat.patch

# The upstream environment pins the inference stack; install its Python-only
# dependencies without replacing the CUDA-matched PyTorch supplied by the base.
RUN pip install --no-cache-dir \
        aiohttp==3.8.6 cryptography==42.0.7 einops==0.7.0 ftfy==6.2.0 \
        gensim==4.3.2 h5py==3.11.0 huggingface-hub==0.23.3 librosa==0.9.2 \
        loguru==0.7.2 matplotlib==3.8.1 moviepy==1.0.3 numpy==1.23.5 omegaconf==2.3.0 pandas==2.2.2 \
        pytorch-lightning==2.1.1 safetensors==0.4.3 scikit-image==0.22.0 \
        scikit-learn==1.5.0 scipy==1.13.1 soundfile==0.12.1 timm==0.4.12 \
        tokenizers==0.19.1 torchlibrosa==0.1.0 torchmetrics==1.2.0 \
        tqdm==4.66.4 transformers==4.41.2 warmup_scheduler==0.3 \
        webdataset==0.2.86 wget==3.2 \
        taming-transformers-rom1504==0.0.6 ruamel.yaml==0.18.6 \
    && pip install --no-cache-dir git+https://github.com/LAION-AI/CLAP.git

# Modern CUDA support is installed after CLAP because its unconstrained
# dependencies otherwise replace GenAU's pinned inference stack.
RUN pip install --no-cache-dir --force-reinstall \
        --index-url https://download.pytorch.org/whl/cu128 \
        torch==2.8.0 torchvision==0.23.0 torchaudio==2.8.0 \
    && pip install --no-cache-dir --force-reinstall --no-deps xformers==0.0.32.post2 \
    && pip install --no-cache-dir --force-reinstall --no-deps \
        huggingface-hub==0.23.3 numpy==1.23.5 setuptools==80.10.2 \
        soxr==0.3.7 tokenizers==0.19.1 transformers==4.41.2

COPY genau/genau.py /opt/genau.py
VOLUME ["/models", "/audio"]
WORKDIR /models/genau
ENTRYPOINT ["python", "-i", "/opt/genau.py"]
