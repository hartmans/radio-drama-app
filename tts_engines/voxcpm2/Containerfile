FROM docker.io/vllm/vllm-openai:v0.30.0

# Match the published Omni release to the vLLM base image.
RUN uv pip install --system --no-cache \
    vllm-omni==0.30.0 voxcpm==2.0.3 soundfile ninja

COPY radio_drama_tts_container /opt/radio_drama_tts_container
COPY tts_engines/voxcpm2/engine.py /opt/voxcpm2_engine.py
COPY tts_engines/voxcpm2/deploy.yaml /opt/voxcpm2.yaml

ENV PYTHONPATH=/opt \
    HF_HOME=/models/huggingface \
    VOXCPM_MODEL=openbmb/VoxCPM2 \
    VLLM_WORKER_MULTIPROC_METHOD=spawn

VOLUME ["/models/huggingface"]
ENTRYPOINT ["python3", "/opt/voxcpm2_engine.py"]
