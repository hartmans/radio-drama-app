# Install as $XDG_CONFIG_HOME/radio-drama/tts.toml, normally
# ~/.config/radio-drama/tts.toml. Build from the repository root:
# TMPDIR=/tmp podman build -f tts_engines/voxcpm2_longform/Containerfile -t localhost/radio-drama-voxcpm2-longform .

[tts.voxcpm2_longform]
image = "localhost/radio-drama-voxcpm2-longform:latest"
devices = ["nvidia.com/gpu=all"]
ipc = "host"

[tts.voxcpm2_longform.environment]
HF_HOME = "/models/huggingface"
HF_HUB_OFFLINE = "1"
VOXCPM_MODEL = "openbmb/VoxCPM2"
# VOXCPM_INFERENCE_TIMESTEPS = "20"
# VOXCPM_CFG_VALUE = "2.0"
XDG_CACHE_HOME = "/voxcpm2_longform_cache"
TORCHINDUCTOR_CACHE_DIR = "/voxcpm2_longform_cache/torchinductor"
TRITON_CACHE_DIR = "/voxcpm2_longform_cache/triton"
VLLM_CACHE_ROOT = "/voxcpm2_longform_cache/vllm"
CUDA_CACHE_PATH = "/voxcpm2_longform_cache/cuda"
# Optional: mount a custom deployment YAML and set VOXCPM_DEPLOY_CONFIG.

[[tts.voxcpm2_longform.mounts]]
source = "~/.cache/radio-drama/voxcpm2-huggingface"
target = "/models/huggingface"
mode = "rw"

[[tts.voxcpm2_longform.mounts]]
source = "~/.cache/radio-drama/voxcpm2_longform_cache"
target = "/voxcpm2_longform_cache"
mode = "rw"
