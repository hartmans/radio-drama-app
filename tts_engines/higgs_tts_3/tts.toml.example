# Install as $XDG_CONFIG_HOME/radio-drama/tts.toml, normally
# ~/.config/radio-drama/tts.toml. Build the image from the repository root:
# just -f tts_engines/higgs_tts_3/justfile build
# just -f tts_engines/higgs_tts_3/justfile download

[tts.higgs]
image = "localhost/radio-drama-higgs-tts-3:latest"
network = "none"
devices = ["nvidia.com/gpu=all"]
ipc = "host"

[[tts.higgs.mounts]]
source = "/srv/ai/huggingface-cache"
target = "/models/huggingface"
mode = "rw"
