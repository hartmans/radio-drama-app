# Install as $XDG_CONFIG_HOME/radio-drama/tts.toml, normally
# ~/.config/radio-drama/tts.toml. Build the image from the repository root:
# just -f tts_engines/higgs_tts_3/justfile build
# just -f tts_engines/higgs_tts_3/justfile download

[tts.higgs]
image = "localhost/radio-drama-higgs-tts-3:latest"
network = "none"
devices = ["nvidia.com/gpu=all"]
ipc = "host"

[tts.higgs.environment]
HF_HOME = "/models/huggingface"
HIGGS_MODEL = "multimodalart/higgs-audio-v3-tts-4b-transformers"
HIGGS_AUDIO_TOKENIZER = "bosonai/higgs-audio-v2-tokenizer"
HIGGS_LOCAL_FILES_ONLY = "true"
HIGGS_TEMPERATURE = "0.8"
HIGGS_TOP_P = "1.0"
HIGGS_TOP_K = "50"
HIGGS_MAX_NEW_TOKENS = "2048"
HIGGS_BATCH_SIZE = "16"

[[tts.higgs.mounts]]
source = "~/.cache/radio-drama/higgs-huggingface"
target = "/models/huggingface"
mode = "rw"
