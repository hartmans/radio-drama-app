# Install as $XDG_CONFIG_HOME/radio-drama/tts.toml, normally
# ~/.config/radio-drama/tts.toml. Build the image from the repository root:
# TMPDIR=/tmp podman build -f tts_engines/higgs_tts_3/Containerfile -t localhost/radio-drama-higgs-tts-3 .

[tts.higgs]
image = "localhost/radio-drama-higgs-tts-3:latest"
network = "host"
devices = ["nvidia.com/gpu=all"]
ipc = "host"

[tts.higgs.environment]
HF_HOME = "/models/huggingface"
HIGGS_MODEL = "bosonai/higgs-tts-3-4b"
HIGGS_TEMPERATURE = "0.8"
HIGGS_TOP_K = "50"
HIGGS_MAX_NEW_TOKENS = "2048"
# Retry pathological high-amplitude utterance onsets, preserving batch support.
HIGGS_ONSET_RETRIES = "2"
HIGGS_ONSET_RMS_THRESHOLD = "0.25"
HIGGS_ONSET_RATIO_THRESHOLD = "3.0"
# Optional low-latency diagnostic; leave unset for the full first codec chunk.
# HIGGS_INITIAL_CODEC_CHUNK_FRAMES = "1"

[[tts.higgs.mounts]]
source = "~/.cache/radio-drama/higgs-huggingface"
target = "/models/huggingface"
mode = "rw"
