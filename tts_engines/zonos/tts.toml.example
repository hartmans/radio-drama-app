# Build from the repository root. Example paths deliberately stay under home:
# podman build -f tts_engines/zonos/Containerfile -t localhost/radio-drama-zonos .

[tts.zonos]
image = "localhost/radio-drama-zonos:latest"
devices = ["nvidia.com/gpu=all"]
ipc = "host"

[tts.zonos.environment]
HF_HOME = "/models/huggingface"
ZONOS_MODEL = "Zyphra/Zonos-v0.1-transformer"
ZONOS_LANGUAGE = "en-us"
ZONOS_BATCH_SIZE = "8"

[[tts.zonos.mounts]]
source = "~/.cache/radio-drama/zonos-huggingface"
target = "/models/huggingface"
mode = "rw"
