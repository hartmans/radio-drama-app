FROM docker.io/lmsysorg/sglang-omni@sha256:46235435997d1fa93fc81fb1c2d5b7fd8470d77395a5c348c0176094ffddf95e

# MOSS-TTSD ships custom Transformers code and requires a current release.
RUN uv pip install --python /opt/omni/bin/python --no-cache transformers==5.14.1

COPY radio_drama_tts_container /opt/radio_drama_tts_container
COPY radio_drama/text.py /opt/radio_drama/text.py
COPY tts_engines/moss_ttsd/engine.py /opt/moss_ttsd_engine.py

ENV PYTHONPATH=/opt \
    HF_HOME=/models/huggingface \
    HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1 \
    MOSS_TTSD_MODEL=OpenMOSS-Team/MOSS-TTSD-v1.0 \
    MOSS_TTSD_DEVICE=cuda \
    MOSS_TTSD_ATTN_IMPLEMENTATION=sdpa \
    MOSS_TTSD_BATCH_SIZE=10 \
    MOSS_TTSD_LOCAL_FILES_ONLY=true

VOLUME ["/models/huggingface"]
ENTRYPOINT ["/opt/omni/bin/python", "/opt/moss_ttsd_engine.py"]
